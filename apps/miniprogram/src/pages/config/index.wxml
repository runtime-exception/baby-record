<page-meta page-style="{{appearanceStyle}}" />
<view class="screen detailScreen">
  <view class="detailHeader">
    <button class="backButton" aria-label="返回" bindtap="back"><view class="backChevron"></view></button>
    <view class="heading">{{title}}</view>
  </view>
  <view class="panel configEditor">
    <view class="muted configLabel">{{editing ? '编辑' : '添加'}}{{label}}</view>
    <view class="row">
      <input value="{{name}}" maxlength="40" data-key="name" bindinput="field" placeholder="{{kind === 'foods' ? '如：玉米' : '输入' + label + '名称'}}" />
      <button class="primary" disabled="{{busy}}" bindtap="save">{{editing ? '保存' : '添加'}}</button>
    </view>
    <view class="row field" wx:if="{{kind !== 'foods'}}">
      <input type="{{kind === 'exercise-configs' ? 'digit' : 'text'}}" value="{{defaultAmount}}" data-key="defaultAmount" bindinput="field" placeholder="默认数量" />
      <picker wx:if="{{kind === 'exercise-configs'}}" range="{{unitOptions}}" bindchange="unit">{{defaultUnit}}</picker>
      <input wx:else value="{{defaultUnit}}" data-key="defaultUnit" bindinput="field" placeholder="默认单位" />
    </view>
    <view class="muted configLabel field">图标</view>
    <view class="emojiGrid">
      <button wx:for="{{emojiOptions}}" wx:key="*this" class="{{emoji === item ? 'chosenIcon' : ''}}" data-value="{{item}}" bindtap="icon">{{item}}</button>
      <button aria-label="自定义图标" class="{{customIcon ? 'chosenIcon' : ''}}" bindtap="custom">＋</button>
    </view>
    <input wx:if="{{customIcon}}" class="field" value="{{emoji}}" data-key="emoji" bindinput="field" placeholder="自定义图标，可留空" />
    <button wx:if="{{editing}}" class="textAction field" disabled="{{busy}}" bindtap="close">取消编辑</button>
  </view>
  <view class="row configSearch">
    <input value="{{search}}" placeholder="搜索{{label}}" bindinput="searchItems" />
    <button class="textAction" wx:if="{{search}}" bindtap="clearSearch">清除</button>
  </view>
  <view class="row filterRow"><text class="muted">仅显示启用项</text><switch checked="{{onlyActive}}" color="#4086f4" bindchange="activeFilter" /></view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <view class="empty" wx:elif="{{!visibleItems.length}}">{{search ? '没有符合条件的配置' : '暂无配置'}}</view>
  <view wx:else class="panel configList">
    <view wx:for="{{visibleItems}}" wx:key="id" class="row configItem">
      <text class="configIcon">{{item.emoji || '•'}}</text>
      <view class="configName">
        <view>{{item.name}}</view>
        <view class="muted">{{item.isActive ? '可用于新记录' : '已停用'}}<text wx:if="{{item.defaultAmount}}"> · {{item.defaultAmount}} {{item.defaultUnit}}</text></view>
      </view>
      <view class="row configActions">
        <button class="textAction" data-id="{{item.id}}" bindtap="edit">{{kind === 'foods' ? '改名' : '编辑'}}</button>
        <button class="textAction {{item.isActive ? 'disableAction' : ''}}" data-id="{{item.id}}" bindtap="changeActive">{{item.isActive ? '停用' : '启用'}}</button>
      </view>
    </view>
  </view>
</view>
