.configLabel { margin-bottom: 12rpx; }
.configEditor .row input, .configEditor .row picker, .configSearch input { flex: 1; min-width: 0; }
.configEditor .primary, .configEditor .textAction { width: auto; flex: none; padding: 20rpx 24rpx; background: var(--accent); color: #fff; }
.emojiGrid { display: grid; grid-template-columns: repeat(8,minmax(0,1fr)); gap: 8rpx; }
.emojiGrid button { width: 100%; padding: 6rpx 0; border: 2rpx solid var(--line); background: var(--input); border-radius: 20rpx; font-size: 30rpx; }
.emojiGrid .chosenIcon { border-color: var(--accent); background: #4086f420; }
.configSearch { margin-top: 20rpx; }
.configSearch input { background: transparent; padding-left: 30rpx; }
.filterRow { padding: 0 30rpx; }
.filterRow switch { transform: scale(.75); transform-origin: right center; }
.configList { padding: 0; }
.configItem { padding: 24rpx 30rpx; }
.configItem + .configItem { border-top: 1rpx solid var(--line); }
.configIcon { flex: none; font-size: 36rpx; }
.configName { flex: 1; min-width: 0; overflow-wrap: break-word; }
.configItem .muted { font-size: calc(var(--font, 30rpx) - 8rpx); margin-top: 4rpx; }
.configActions { flex: none; }
.configActions button { width: 62rpx; }
.configActions .disableAction { color: #e64968; }
