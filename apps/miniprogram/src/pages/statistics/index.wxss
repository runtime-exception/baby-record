.chartTitle { font-size: calc(var(--font, 30rpx) - 3rpx); font-weight: 650; }
.chartEmpty { padding: 65rpx 0; text-align: center; color: var(--muted); font-size: calc(var(--font, 30rpx) - 7rpx); }
.statsChart { display: block; width: 100%; height: 200px; margin-top: 10rpx; }
.legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 8rpx 16rpx; margin-top: 18rpx; }
.legendItem { font-size: calc(var(--font, 30rpx) - 10rpx); color: var(--muted); }
.chartMeta { color: var(--muted); font-size: calc(var(--font, 30rpx) - 8rpx); flex-wrap: wrap; gap: 6rpx 12rpx; }
.chartTotal, .rangeStatus { color: #55b861; font-weight: 650; }
.rangeStatus { font-size: calc(var(--font, 30rpx) - 8rpx); }
.outOfRange { color: #e64968; }
.referenceTrack { position: relative; height: 11rpx; border-radius: 20rpx; background: linear-gradient(90deg,#55b861,#efa13e 55%,#e64968); margin: 15rpx 6rpx 10rpx; }
.referenceMarker { position: absolute; top: 50%; transform: translate(-50%,-50%); width: 22rpx; height: 22rpx; border-radius: 50%; background: #fff; border: 2rpx solid var(--line); }
.sourceNote { color: var(--muted); font-size: calc(var(--font, 30rpx) - 10rpx); margin-top: 16rpx; }
.sourceNote text { color: var(--accent); text-decoration: underline; }
