<page-meta page-style="{{appearanceStyle}}" />
<view class="screen tabScreen">
  <view class="pageIntro"><view class="heading">统计</view><view class="subtitle">宝宝成长趋势</view></view>
  <view class="panel">
    <view class="segment">
      <button wx:for="{{options}}" wx:key="value" class="{{range === item.value ? 'current' : ''}}" data-range="{{item.value}}" bindtap="chooseRange">{{item.label}}</button>
    </view>
    <view class="dateRange field" wx:if="{{range === 'custom'}}">
      <picker mode="date" end="{{today}}" value="{{startDate}}" data-field="start" bindchange="changeDate">
        <view class="dateValue"><text>{{startDate}}</text><view class="dateGlyph"></view></view>
      </picker>
      <text class="muted">至</text>
      <picker mode="date" start="{{startDate}}" end="{{today}}" value="{{endDate}}" data-field="end" bindchange="changeDate">
        <view class="dateValue"><text>{{endDate}}</text><view class="dateGlyph"></view></view>
      </picker>
    </view>
  </view>
  <view class="empty" wx:if="{{loading}}">加载中…</view>
  <button class="error" wx:if="{{error}}" bindtap="refresh">{{error}} · 点击重试</button>
  <block wx:if="{{overview && !loading}}">
    <view class="panel" wx:for="{{charts}}" wx:for-item="chart" wx:key="key">
      <view class="row">
        <view class="chartTitle">{{chart.title}}</view>
        <text class="chartTotal" wx:if="{{chart.distribution}}">{{overview.supplement.count}} 次</text>
      </view>
      <view class="chartEmpty" wx:if="{{chart.empty}}">{{chart.source ? (chart.key === 'height' ? '暂无身高记录，去「记录 → 其他」添加' : '暂无体重记录，去「记录 → 其他」添加') : '暂无数据'}}</view>
      <block wx:else>
        <view wx:if="{{chart.series.length > 1 && !chart.distribution}}" class="legend">
          <view wx:for="{{chart.series}}" wx:key="name" class="legendItem"><text style="color:{{item.color}}">●</text> {{item.name}}</view>
        </view>
        <canvas canvas-id="chart-{{chart.key}}" class="statsChart" data-key="{{chart.key}}" bindtap="showValue" />
        <view wx:if="{{chart.distribution}}" class="legend">
          <view wx:for="{{chart.series}}" wx:key="name" class="legendItem"><text style="color:{{item.color}}">●</text> {{item.name}} {{item.data[0]}}次</view>
        </view>
        <block wx:if="{{chart.latest}}">
          <view class="row chartMeta">
            <text>{{chart.latest}}</text>
            <text class="rangeStatus {{chart.percent < 0 || chart.percent > 100 ? 'outOfRange' : ''}}">位于参考区间 {{chart.percent == null ? '—' : chart.percent + '%'}}</text>
          </view>
          <block wx:if="{{chart.percent != null}}">
            <view class="referenceTrack"><view class="referenceMarker" style="left:{{chart.marker}}%"></view></view>
            <view class="rangeStatus {{chart.percent < 0 || chart.percent > 100 ? 'outOfRange' : ''}}">{{chart.status}}</view>
          </block>
        </block>
      </block>
      <view wx:if="{{chart.source}}" class="sourceNote">参考标准：<text data-source="{{chart.source}}" bindtap="copySource">WHO 儿童生长标准 ↗</text></view>
    </view>
  </block>
</view>
