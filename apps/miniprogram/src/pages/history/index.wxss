.sheetBackdrop { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: #16223372; }
.sheet { width: 100%; margin: 0; padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); border-radius: 40rpx 40rpx 0 0; }
.rangePanel { margin-top: 30rpx; }
.rangePanel .dateRange { margin: 12rpx 0 18rpx; }
.filterScroll { width: 100%; white-space: nowrap; }
.filters { display: inline-flex; gap: 14rpx; }
.filters .chip { flex: none; padding: 10rpx 22rpx; color: var(--muted); font-size: calc(var(--font, 30rpx) - 8rpx); }
.filters .selected { color: #fff; background: var(--accent); }
.timeline { margin-top: 30rpx; }
.timelineRow { display: flex; gap: 18rpx; margin-bottom: 22rpx; --dot: #55b861; }
.timelineRow.feeding { --dot: #ef9a39; }
.timelineRow.diaper { --dot: #4487ee; }
.timelineRow.sleep { --dot: #ab61dd; }
.timelineRow.temperature { --dot: #e64968; }
.timelineRail { width: 98rpx; flex: none; display: flex; flex-direction: column; align-items: center; padding-top: 8rpx; }
.timelineRail::after { content: ''; background: var(--line); flex: 1; width: 3rpx; margin: 6rpx 0 -12rpx; }
.timelineRow:last-child .timelineRail::after { display: none; }
.dayBadge { border-radius: 16rpx; background: var(--input); padding: 4rpx 7rpx; font-size: calc(var(--font, 30rpx) - 11rpx); white-space: nowrap; }
.timelineTime, .timelineDetail { font-size: calc(var(--font, 30rpx) - 7rpx); color: var(--muted); }
.timelineTime { margin: 6rpx 0 9rpx; font-variant-numeric: tabular-nums; }
.timelineDot { width: 18rpx; height: 18rpx; border-radius: 50%; background: var(--dot); }
.timelineCard { flex: 1; min-width: 0; background: var(--card); padding: 24rpx 26rpx; border-radius: 30rpx; }
.recordTitle { min-width: 0; overflow-wrap: break-word; font-size: calc(var(--font, 30rpx) - 3rpx); font-weight: 600; }
.recordIcon { font-size: 32rpx; margin-right: 12rpx; }
.recordActions { display: flex; gap: 20rpx; flex: none; }
.recordActions button { width: 54rpx; color: var(--muted); font-size: calc(var(--font, 30rpx) - 7rpx); }
.recordActions .deleteAction { color: #e64968; }
.timelineDetail { margin-top: 8rpx; }

.recordTimelineScreen { padding-bottom: 156rpx; }
.addRecordBar { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; padding: 16rpx 38rpx 24rpx; background: var(--bg); }
button.addRecordButton { width: 100%; padding: 24rpx 12rpx; border-radius: 30rpx; background: var(--accent); color: #fff; font-weight: 650; }
.recordCreationLayer { position: fixed; z-index: 40; inset: 0; }
.creationBackdrop { position: absolute; inset: 0; background: #16223372; opacity: 0; transition: opacity 280ms var(--anchor-collapse-fade); }
.creationBackdrop.visible { opacity: 1; transition-timing-function: ease; }
.recordTypesPosition { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; }
.recordCreationSurface {
  transform-origin: 0 0;
  transform: translate(var(--entry-x, 0px), var(--entry-y, 0px)) scale(var(--entry-scale-x, 1), var(--entry-scale-y, 1));
  border-radius: 36rpx;
  opacity: 0;
  pointer-events: none;
  overflow: hidden;
  transition: transform var(--entry-duration, 280ms) var(--anchor-collapse-easing),
    opacity var(--entry-duration, 280ms) var(--anchor-collapse-fade),
    border-radius var(--entry-duration, 280ms) var(--anchor-collapse-fade);
}
.recordCreationSurface.expanded {
  transform: none;
  opacity: 1;
  pointer-events: auto;
  transition-timing-function: var(--anchor-expand-easing), ease, ease;
}
.recordTypes { display: flex; flex-direction: column; box-sizing: border-box; width: calc(100% - 64rpx); height: 740rpx; max-height: calc(100% - 2 * (var(--status-inset, 20px) + 30rpx)); padding: 30rpx; background: var(--card); box-shadow: 0 20rpx 70rpx #14274338; }
.recordTypes .title { flex: none; margin-bottom: 18rpx; }
.recordTypesScroll { flex: 1; height: 0; min-height: 0; }
.recordTypesGrid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; }
.recordTypesGrid button { width: 100%; min-width: 0; padding: 12rpx 2rpx; color: var(--text); background: var(--input); font-size: calc(var(--font, 30rpx) - 6rpx); }
.recordTypesGrid .shortcutIcon { margin-bottom: 2rpx; }
button.creationCancel { flex: none; width: 100%; margin-top: 18rpx; color: var(--muted); background: var(--input); }
.recordCreateForm { position: absolute; inset: 0; background: var(--bg); }
.recordCreateForm.expanded { border-radius: 0; }
.recordFormScroll { width: 100%; height: 100%; }
