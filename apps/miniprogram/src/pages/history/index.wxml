<page-meta page-style="{{appearanceStyle}}" />
<view class="screen tabScreen">
  <view class="heading pageIntro">记录</view>
  <view class="shortcuts">
    <button wx:for="{{quick}}" wx:key="kind" data-kind="{{item.kind}}" bindtap="create">
      <text class="shortcutIcon">{{item.icon}}</text>{{item.label}}
    </button>
  </view>
  <include src="./timeline.wxml" />
</view>
