<page-meta page-style="{{appearanceStyle}}{{switcherOpen ? ';overflow:hidden' : ''}}" />
<view class="screen tabScreen">
  <view wx:if="{{loading && !baby}}" class="empty">加载中…</view>
  <button wx:if="{{error}}" class="error" bindtap="refresh">{{error}} · 点击重试</button>
  <block wx:if="{{baby}}">
    <view class="babyIntro">
      <view class="avatarTrigger" bindtap="openSwitcher" hover-class="pressed" aria-role="button" aria-label="切换宝宝">
        <image wx:if="{{avatar}}" class="avatar" src="{{avatar}}" mode="aspectFill" />
        <view wx:else class="avatar avatarFallback">👶</view>
      </view>
      <view class="babyIdentity">
        <view class="heading">{{baby.nickname || baby.name}}（{{baby.age.totalMonths}}个月{{baby.age.days}}天）</view>
        <view wx:if="{{growth}}" class="subtitle">{{growth}}</view>
      </view>
    </view>
    <view wx:for="{{cards}}" wx:key="kind" class="panel dashboardCard {{item.kind}}">
      <view class="row dashboardCardHeader">
        <view class="muted"><text class="dashboardIcon">{{item.icon}}</text>{{item.label}}</view>
        <button class="textAction" data-kind="{{item.kind}}" bindtap="open">记录</button>
      </view>
      <view wx:if="{{item.value}}" class="dashboardValue {{item.tone}}">
        <text>{{item.value}}</text><text wx:if="{{item.status}}" class="statusText {{item.status.tone}}">{{item.status.text}}</text>
      </view>
      <view wx:if="{{item.detail}}" class="caption">
        <text>{{item.detail}}</text>
        <block wx:if="{{item.advice}}"> · <text class="advice" data-kind="{{item.kind}}" bindtap="advice">{{item.advice}}</text>{{item.extra}}</block>
      </view>
      <view wx:if="{{item.warning}}" class="temperatureWarning">宝宝体温需要关注<view class="caption">请在宝宝平稳状态下进行测量</view></view>
    </view>
    <button class="panel homeLink allergy" bindtap="toggleAllergy" hover-class="pressed">
      <text class="linkIcon">🥣</text><view class="linkBody"><view class="linkTitle">宝宝辅食排敏</view><view class="caption">{{allergyHeadline}}</view></view>
      <text class="linkChevron">{{showAllergy ? '⌄' : '›'}}</text>
    </button>
    <view wx:if="{{showAllergy}}" class="allergyBackdrop" bindtap="toggleAllergy">
      <scroll-view scroll-y class="allergySheet" catchtap="keepAllergyOpen">
        <view class="row"><view class="title">宝宝辅食排敏</view><button class="textAction closeAllergy" bindtap="toggleAllergy">关闭</button></view>
        <view wx:if="{{!summary.foodAllergySummary.allergic.length && !summary.foodAllergySummary.possible.length && !summary.foodAllergySummary.notAllergic.length}}" class="empty">暂无排敏记录</view>
        <view class="line muted" wx:for="{{summary.foodAllergySummary.allergic}}" wx:key="foodId">{{item.foodName}} · 过敏</view>
        <view class="line muted" wx:for="{{summary.foodAllergySummary.possible}}" wx:key="foodId">{{item.foodName}} · 可能过敏</view>
        <view class="line muted" wx:for="{{summary.foodAllergySummary.notAllergic}}" wx:key="foodId">{{item.foodName}} · 未发现过敏</view>
        <button class="primary section" data-kind="foodAllergy" bindtap="open">记录辅食排敏</button>
      </scroll-view>
    </view>
    <view class="sectionCaption quickCaption">快捷操作</view>
    <view class="panel shortcuts homeShortcuts">
      <button wx:for="{{quick}}" wx:key="kind" data-kind="{{item.kind}}" bindtap="open">
        <text class="shortcutIcon {{item.kind}}">{{item.icon}}</text>{{item.label}}
      </button>
    </view>
    <button class="panel homeLink" bindtap="history" hover-class="pressed">
      <text class="linkIcon">📋</text><view class="linkBody"><view class="linkTitle">历史记录</view><view class="caption">查看每天喂养 / 睡眠 / 护理时间轴</view></view>
      <text class="linkChevron">›</text>
    </button>
  </block>
  <view wx:if="{{switcherOpen}}" class="switcherOverlay {{switcherExpanded ? 'expanded' : ''}}">
    <view class="switcherBackdrop" bindtap="closeSwitcher" catchtouchmove="noop"></view>
    <view class="babySwitchSheet" style="{{switcherStyle}}" aria-role="dialog" aria-label="切换宝宝">
      <view class="switchHeader title">切换宝宝</view>
      <scroll-view class="switchScroll" scroll-y>
        <view wx:if="{{!switchCards.length}}" class="muted switchLoading">加载中…</view>
        <view
          wx:for="{{switchCards}}"
          wx:key="id"
          class="switchCard {{item.id === baby.id ? 'switchCardActive' : ''}}"
          style="background: {{item.theme}};"
          data-id="{{item.id}}"
          bindtap="chooseBaby"
          hover-class="pressed"
        >
          <view class="switchTop">
            <view class="switchPortrait">
              <image wx:if="{{item.avatar}}" class="switchAvatar" src="{{item.avatar}}" mode="aspectFill" />
              <view wx:else class="switchAvatar switchAvatarFallback">👶</view>
            </view>
            <view class="switchIdentity">
              <view class="switchNameLine">
                <text class="switchName">{{item.displayName}}</text>
                <text class="switchBadge">{{item.genderLabel}}</text>
                <text wx:if="{{item.id === baby.id}}" class="switchCurrent">当前</text>
              </view>
              <view class="switchBirth">出生 {{item.birthday}}</view>
            </view>
          </view>
          <view class="switchBottom">
            <view class="switchAge">
              <view class="switchAgeLine"><text class="switchAgeNumber">{{item.age.totalMonths}}</text><text>个月{{item.age.days}}天</text></view>
              <view class="switchAgeCaption">共 {{item.age.totalDays}} 天</view>
            </view>
            <view class="switchMetrics">
              <text>{{item.heightText}}</text>
              <text>{{item.weightText}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="switchActions">
        <button class="switchAdd" bindtap="addBaby">＋ 添加宝宝</button>
        <button class="switchClose" bindtap="closeSwitcher">关闭</button>
      </view>
    </view>
  </view>
</view>
