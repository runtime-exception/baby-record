<page-meta page-style="{{appearanceStyle}}" />
<view class="screen tabScreen">
  <view class="pageIntro"><view class="heading">我的</view><view class="subtitle">宝宝档案与设置</view></view>
  <button class="error" wx:if="{{error}}" bindtap="refresh">{{error}} · 点击重试</button>
  <block wx:if="{{baby}}">
    <view class="panel profileHero">
      <view class="row heroTop">
        <view class="portrait" bindtap="chooseAvatar">
          <image wx:if="{{avatar}}" class="avatar" src="{{avatar}}" mode="aspectFill" />
          <view wx:else class="avatar">👶</view>
          <view wx:if="{{baby.membership.isAdmin}}" class="portraitEdit">{{avatarUploading ? '上传中' : '更换'}}</view>
        </view>
        <view class="profileIdentity">
          <view class="heroNameLine">
            <text class="title heroName">{{displayName}}</text>
            <text class="heroBadge">{{gender}}</text>
          </view>
          <view class="heroCaption heroBirthday">出生 {{baby.birthday}}</view>
        </view>
      </view>
      <view class="heroBottom">
        <view class="ageBlock">
          <view class="ageLine"><text class="ageNumber">{{baby.age.totalMonths}}</text><text>个月{{baby.age.days}}天</text></view>
          <view class="heroCaption">共 {{baby.age.totalDays}} 天</view>
        </view>
        <view class="heroActions">
          <button class="heroPill heroEditPill" wx:if="{{baby.membership.isAdmin}}" aria-label="编辑宝宝" bindtap="edit">✎</button>
          <button class="heroPill heroSwitchPill" wx:if="{{list.length > 1}}" bindtap="openSwitcher">切换</button>
        </view>
      </view>
    </view>
    <view class="sectionCaption profileCaption">家庭信息</view>
    <view class="panel profileItem">
      <text class="profileIcon">👤</text>
      <view class="profileName"><view class="itemTitle">{{baby.membership.name}}</view><view class="muted">{{roleCaption}}</view></view>
      <button class="textAction" bindtap="members">家庭成员 ›</button>
    </view>
    <view class="sectionCaption profileCaption">记录配置</view>
    <view wx:for="{{config}}" wx:key="kind" class="panel profileItem" data-kind="{{item.kind}}" bindtap="openConfig" hover-class="pressed">
      <text class="profileIcon">{{item.icon}}</text>
      <view class="profileName"><view class="itemTitle">{{item.label}}</view><view class="muted">{{item.tip}}</view></view><text class="muted">›</text>
    </view>
    <view class="sectionCaption profileCaption">外观</view>
    <view class="panel appearancePanel">
      <view class="muted">界面主题</view>
      <view class="segment appearanceSegment">
        <button class="{{appearance.theme === 'ios' ? 'current' : ''}}" data-value="ios" bindtap="changeTheme">iOS</button>
        <button class="{{appearance.theme === 'material' ? 'current' : ''}}" data-value="material" bindtap="changeTheme">Material</button>
      </view>
      <view class="field"><view class="muted">明暗模式</view><view class="segment appearanceSegment">
        <button class="{{appearance.mode === 'light' ? 'current' : ''}}" data-value="light" bindtap="changeMode">浅色</button>
        <button class="{{appearance.mode === 'dark' ? 'current' : ''}}" data-value="dark" bindtap="changeMode">深色</button>
        <button class="{{appearance.mode === 'auto' ? 'current' : ''}}" data-value="auto" bindtap="changeMode">跟随系统</button>
      </view></view>
      <view class="row line"><text>老年人模式</text><switch checked="{{appearance.senior}}" color="#007aff" bindchange="senior" /></view>
    </view>
    <view class="sectionCaption profileCaption">宝宝与家庭</view>
    <view class="panel familyPanel">
      <view class="row"><text class="babyId">宝宝 ID {{baby.id}}</text><button class="textAction" bindtap="copyId">复制</button></view>
      <view class="row line"><button class="textAction" bindtap="add">添加宝宝</button><button class="textAction" bindtap="bind">绑定宝宝</button></view>
    </view>
    <view class="panel"><view class="title">出生信息</view>
      <view class="row line"><text>体重</text><text>{{baby.birthWeight || '—'}} kg</text></view>
      <view class="row line"><text>身高</text><text>{{baby.birthHeight || '—'}} cm</text></view>
      <view class="row line"><text>头围</text><text>{{baby.headCircumference || '—'}} cm</text></view>
      <view class="row line"><text>出生医院</text><text>{{baby.birthHospital || '—'}}</text></view>
      <view class="row line"><text>备注</text><text>{{baby.remark || '—'}}</text></view>
    </view>
  </block>
  <button class="danger section logoutButton" bindtap="logout">退出登录</button>
  <view wx:if="{{switcherOpen}}" class="sheetBackdrop" bindtap="closeSwitcher">
    <view class="switchSheet" catchtap="noop">
      <view class="switchHeader">
        <text class="title">切换宝宝</text>
        <button class="switchClose" bindtap="closeSwitcher">关闭</button>
      </view>
      <view wx:if="{{!switchCards.length}}" class="muted switchLoading">加载中…</view>
      <scroll-view class="switchScroll" style="height: {{switchScrollHeight}}" scroll-y>
        <view
          wx:for="{{switchCards}}"
          wx:key="id"
          class="panel profileHero switchCard {{item.id === baby.id ? 'switchCardActive' : ''}}"
          data-id="{{item.id}}"
          bindtap="chooseBaby"
        >
          <view class="row heroTop">
            <view class="portrait">
              <image wx:if="{{item.avatar}}" class="avatar" src="{{item.avatar}}" mode="aspectFill" />
              <view wx:else class="avatar">👶</view>
            </view>
            <view class="profileIdentity">
              <view class="heroNameLine">
                <text class="title heroName">{{item.displayName}}</text>
                <text class="heroBadge">{{item.genderLabel}}</text>
              </view>
              <view class="heroCaption heroBirthday">出生 {{item.birthday}}</view>
            </view>
          </view>
          <view class="heroBottom">
            <view class="ageBlock">
              <view class="ageLine"><text class="ageNumber">{{item.age.totalMonths}}</text><text>个月{{item.age.days}}天</text></view>
              <view class="heroCaption">共 {{item.age.totalDays}} 天</view>
            </view>
          </view>
        </view>
      </scroll-view>
      <button class="switchAdd" bindtap="add">＋ 新增宝宝</button>
    </view>
  </view>
  <canvas canvas-id="avatarCanvas" class="avatarCanvas" />
</view>
