.babyStack { position: relative; margin-top: 24rpx; }
.profileHero { position: relative; color: #fff; padding: 38rpx; }
.profileHeroMain { z-index: 10; }
.babyStack .profileHero { margin-top: 0; }
.babyStack .heroTop { padding-right: 76rpx; }
.babyStackCard { position: absolute; overflow: hidden; box-sizing: border-box; margin: 0; padding: 0; transform: translateZ(0); }
.profileHero .heroTop { justify-content: flex-start; gap: 24rpx; }
.portrait { position: relative; flex: none; overflow: hidden; border-radius: 50%; }
.portrait .avatar { width: 128rpx; height: 128rpx; border: 4rpx solid #ffffff70; }
.portraitEdit { position: absolute; bottom: 3rpx; left: 0; right: 0; background: #00000045; text-align: center; font-size: 20rpx; line-height: 30rpx; }
.profileName { flex: 1; min-width: 0; overflow-wrap: break-word; }
.profileIdentity { flex: 1; min-width: 0; }
.heroNameLine { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; }
.heroName { max-width: 100%; overflow-wrap: anywhere; }
.heroBirthday { margin-top: 8rpx; }
.heroCaption { font-size: calc(var(--font, 30rpx) - 4rpx); color: #ffffffe0; }
.heroBadge { width: auto; flex: none; border-radius: 50rpx; padding: 8rpx 15rpx; font-size: 22rpx; white-space: nowrap; color: #fff; background: #ffffff36; }
.heroBottom { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 16rpx; margin-top: 32rpx; }
.ageBlock { flex: none; white-space: nowrap; }
.ageLine { display: flex; align-items: baseline; white-space: nowrap; color: #ffffffe0; }
.ageLine text, .ageBlock .heroCaption { white-space: nowrap; }
.ageNumber { font-size: calc(var(--font, 30rpx) + 38rpx); font-weight: 700; color: #fff; margin-right: 8rpx; }
.heroGrowth { display: flex; flex: none; flex-direction: column; align-items: flex-start; gap: 4rpx; margin-left: auto; color: #ffffffe8; font-size: calc(var(--font, 30rpx) - 6rpx); line-height: 1.35; text-align: left; white-space: nowrap; }
button.heroEditCircle { position: absolute; top: 28rpx; right: 28rpx; z-index: 2; display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin: 0; padding: 0; border-radius: 50%; color: #3474db; background: #ffffffeb; box-shadow: 0 6rpx 18rpx rgba(26,62,115,.18); line-height: 1; font-size: 30rpx; }
.stackSwitcherBackdrop {
  position: fixed;
  z-index: 30;
  inset: 0;
  opacity: 0;
  background: #0d1829a8;
  transition: opacity .24s ease;
}
.stackSwitcherBackdrop.visible { opacity: 1; }
.stackSwitcherPanel {
  position: fixed;
  z-index: 31;
  overflow: hidden;
  box-sizing: border-box;
  background: var(--bg,#f2f2f7);
  box-shadow: 0 20rpx 70rpx rgba(20,39,67,.22);
  transition: left .28s cubic-bezier(.2,.74,.24,1), top .28s cubic-bezier(.2,.74,.24,1),
    width .28s cubic-bezier(.2,.74,.24,1), height .28s cubic-bezier(.2,.74,.24,1),
    border-radius .28s cubic-bezier(.2,.74,.24,1);
}
.stackSwitcherSeed {
  position: absolute;
  z-index: 0;
  inset: 0;
  opacity: 1;
  transition: opacity .2s ease;
}
.stackSwitcherPanel.expanded .stackSwitcherSeed { opacity: 0; }
.stackSwitcherContent {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  height: 100%;
  padding: 28rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  opacity: 0;
  pointer-events: none;
  transition: opacity .16s ease;
}
.stackSwitcherContent.visible { opacity: 1; pointer-events: auto; }
.switchHeader { display: flex; align-items: center; justify-content: space-between; padding: 4rpx 6rpx 18rpx; }
button.switchClose { width: auto; padding: 6rpx 0; color: var(--muted); background: transparent; font-size: calc(var(--font, 30rpx) - 6rpx); }
.switchLoading { padding: 36rpx 0; text-align: center; }
.switchScroll { box-sizing: border-box; }
.stackSwitchScroll { flex: 1; min-height: 0; }
.switchCard { margin-top: 18rpx; padding: 30rpx; }
.switchCardActive { box-shadow: 0 0 0 4rpx #ffffff8f inset, 0 4rpx 18rpx rgba(29,57,94,.12); }
.switchAdd { width: 100%; margin-top: 22rpx; padding: 22rpx 0; border-radius: 999rpx; color: var(--accent,#007aff); background: #ffffff; border: 2rpx dashed #c9d8ea; font-weight: 600; }

.avatarEditorBackdrop {
  position: fixed;
  z-index: 50;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 32rpx;
  background: #0b1424b8;
}
.avatarEditorCard {
  box-sizing: border-box;
  width: 100%;
  max-width: 650rpx;
  overflow: hidden;
  padding: 34rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 38rpx;
  background: var(--card,#fff);
  box-shadow: 0 30rpx 80rpx rgba(7,18,36,.3);
}
.avatarEditorTitle { text-align: center; font-size: calc(var(--font, 30rpx) + 8rpx); font-weight: 700; }
.avatarEditorHint { margin-top: 8rpx; color: var(--muted); text-align: center; font-size: calc(var(--font, 30rpx) - 7rpx); }
.avatarCropViewport { position: relative; overflow: hidden; flex: none; margin: 30rpx auto 0; border-radius: 50%; background: #172233; box-shadow: 0 0 0 6rpx #ffffff inset, 0 10rpx 32rpx rgba(16,35,61,.2); }
.avatarCropImage { position: absolute; max-width: none; transform-origin: center center; will-change: transform; }
.avatarCropGuide { position: absolute; inset: 0; border: 3rpx solid #ffffffa8; border-radius: 50%; box-shadow: inset 0 0 0 2rpx #00000014; pointer-events: none; }
.avatarZoom { margin: 24rpx 2rpx 0; }
.avatarEditorScale { display: flex; justify-content: space-between; margin-top: -8rpx; padding: 0 12rpx; color: var(--muted); font-size: calc(var(--font, 30rpx) - 8rpx); }
.avatarEditorActions { display: flex; justify-content: space-between; width: 100%; max-width: 100%; box-sizing: border-box; margin-top: 28rpx; }
.avatarEditorActions button {
  display: block;
  flex: none;
  width: calc(50% - 9rpx);
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
  margin: 0;
  padding: 20rpx 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  border-radius: 999rpx;
  font-weight: 600;
  white-space: nowrap;
}
.avatarEditorCancel { color: var(--muted); background: var(--input); }
.avatarEditorConfirm { color: #fff; background: #3474db; }
.avatarCanvas { position: fixed; left: 0; top: 0; width: 512px; height: 512px; opacity: 0; z-index: -1; pointer-events: none; }
.profileCaption { margin: 32rpx 0 16rpx; }
.profileCaption + .panel { margin-top: 0; }
.profileItem { display: flex; align-items: center; gap: 20rpx; }
.profileItem .muted { margin-top: 5rpx; }
.profileIcon { display: grid; width: 80rpx; height: 80rpx; place-items: center; border-radius: 50%; flex: none; background: #4286ef20; font-size: 40rpx; }
.itemTitle { font-size: calc(var(--font, 30rpx) - 2rpx); font-weight: 650; }
.profileItem .textAction { flex: none; width: 150rpx; justify-content: flex-end; white-space: nowrap; }
.appearanceSegment { margin-top: 12rpx; }
button.logoutButton { width: 100%; color: #e64968; background: var(--card); }
.pressed { opacity: .72; }
