.profileHero { background: linear-gradient(145deg,#387de9,#80c9ec); color: #fff; padding: 38rpx; }
.profileHero .heroTop { justify-content: flex-start; gap: 24rpx; }
.portrait { position: relative; flex: none; overflow: hidden; border-radius: 50%; }
.portrait .avatar { width: 128rpx; height: 128rpx; border: 4rpx solid #ffffff70; }
.portraitEdit { position: absolute; bottom: 3rpx; left: 0; right: 0; background: #00000045; text-align: center; font-size: 20rpx; line-height: 30rpx; }
.profileName { flex: 1; min-width: 0; overflow-wrap: break-word; }
.profileIdentity { flex: 1; min-width: 0; }
.heroNameLine { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; }
.heroName { max-width: 100%; overflow-wrap: anywhere; }
.heroBirthday { margin-top: 8rpx; }
.heroCaption { font-size: calc(var(--font, 30rpx) - 4rpx); color: #ffffffe0; }
.heroBadge { width: auto; flex: none; border-radius: 50rpx; padding: 8rpx 15rpx; font-size: 22rpx; white-space: nowrap; color: #fff; background: #ffffff36; }
.heroBottom { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 16rpx; margin-top: 32rpx; }
.ageBlock { flex: none; white-space: nowrap; }
.ageLine { display: flex; align-items: baseline; white-space: nowrap; color: #ffffffe0; }
.ageLine text, .ageBlock .heroCaption { white-space: nowrap; }
.ageNumber { font-size: calc(var(--font, 30rpx) + 38rpx); font-weight: 700; color: #fff; margin-right: 8rpx; }
.heroActions { display: flex; align-items: center; gap: 12rpx; flex: none; margin-left: auto; }
.heroPill { box-sizing: border-box; display: flex; align-items: center; justify-content: center; width: auto; height: 56rpx; padding: 0 22rpx; flex: none; border-radius: 999rpx; color: #fff; background: #ffffff3d; line-height: 1; font-size: calc(var(--font, 30rpx) - 6rpx); }
.heroEditPill { min-width: 0; padding: 0 20rpx; font-size: 30rpx; }
.sheetBackdrop { position: fixed; z-index: 30; inset: 0; display: flex; align-items: flex-end; background: #16223372; }
.switchSheet { width: 100%; box-sizing: border-box; padding: 28rpx 30rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius: 40rpx 40rpx 0 0; background: var(--bg,#f2f2f7); }
.switchHeader { display: flex; align-items: center; justify-content: space-between; padding: 4rpx 6rpx 18rpx; }
button.switchClose { width: auto; padding: 6rpx 0; color: var(--muted); background: transparent; font-size: calc(var(--font, 30rpx) - 6rpx); }
.switchLoading { padding: 36rpx 0; text-align: center; }
.switchScroll { box-sizing: border-box; }
.switchCard { margin-top: 18rpx; padding: 30rpx; }
.switchCardActive { box-shadow: 0 0 0 4rpx #ffffff8f inset, 0 4rpx 18rpx rgba(29,57,94,.12); }
.switchAdd { width: 100%; margin-top: 22rpx; padding: 22rpx 0; border-radius: 999rpx; color: var(--accent,#007aff); background: #ffffff; border: 2rpx dashed #c9d8ea; font-weight: 600; }
.avatarCanvas { position: fixed; left: 0; top: 0; width: 512px; height: 512px; opacity: 0; z-index: -1; pointer-events: none; }
.profileCaption { margin: 32rpx 0 16rpx; }
.profileCaption + .panel { margin-top: 0; }
.profileItem { display: flex; align-items: center; gap: 20rpx; }
.profileItem .muted { margin-top: 5rpx; }
.profileIcon { display: grid; width: 80rpx; height: 80rpx; place-items: center; border-radius: 50%; flex: none; background: #4286ef20; font-size: 40rpx; }
.itemTitle { font-size: calc(var(--font, 30rpx) - 2rpx); font-weight: 650; }
.profileItem .textAction { flex: none; width: 150rpx; justify-content: flex-end; white-space: nowrap; }
.familyPanel .textAction { flex: none; max-width: 160rpx; }
.appearanceSegment { margin-top: 12rpx; }
.babyId { overflow-wrap: anywhere; }
button.logoutButton { width: 100%; color: #e64968; background: var(--card); }
.pressed { opacity: .72; }
