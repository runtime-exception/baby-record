<template name="recordTime">
  <view class="panel formPanel">
    <view class="formLabel">{{label}}</view>
    <view class="recordDateTime">
      <view><view class="inputCaption">日期</view><picker mode="date" value="{{date}}" end="{{today}}" data-key="date" bindchange="field">{{date}}</picker></view>
      <view><view class="inputCaption">时间</view><picker mode="time" value="{{time}}" data-key="time" bindchange="field">{{time}}</picker></view>
    </view>
    <view wx:if="{{quickTime}}" class="timePresets">
      <button wx:for="{{timePresets}}" wx:key="minutes" data-minutes="{{item.minutes}}" bindtap="presetTime">{{item.label}}</button>
    </view>
  </view>
</template>

<view hidden="{{embedded && customOpen}}" class="screen detailScreen recordForm {{parent === 'other' ? kind + ' otherForm' : kind}}">
  <view class="detailHeader">
    <button class="backButton" aria-label="返回" disabled="{{busy}}" bindtap="back"><view class="backChevron"></view></button>
    <view class="heading">{{title}}</view>
  </view>
  <view class="panel formPanel" wx:if="{{parent === 'other'}}">
    <view class="formLabel">记录类型</view>
    <view class="optionGrid fourOptions">
      <button wx:for="{{other}}" wx:key="label" class="{{index === otherIndex ? 'chosen' : ''}}" data-index="{{index}}" disabled="{{busy}}" bindtap="chooseOther">
        <text class="optionIcon">{{item.icon}}</text>{{item.label}}
      </button>
    </view>
  </view>
  <button wx:if="{{error}}" class="error" bindtap="retry">{{error}} · 点击重试</button>
  <view class="empty" wx:elif="{{!ready}}">正在加载表单…</view>
  <block wx:if="{{ready}}">
    <template wx:if="{{kind === 'feeding' || kind === 'diaper'}}" is="recordTime" data="{{label:'时间', date, time, today, quickTime:true, timePresets}}" />

    <view class="panel formPanel" wx:if="{{kind === 'feeding' || kind === 'diaper' || kind === 'sleep'}}">
      <view class="formLabel">{{kind === 'sleep' ? '睡眠类型' : '类型'}}</view>
      <view wx:if="{{kind === 'feeding'}}" class="optionGrid">
        <button wx:for="{{componentChoices}}" wx:key="value" class="{{item.selected ? 'chosen' : ''}}" data-value="{{item.value}}" bindtap="toggleComponent">
          <text class="optionIcon">{{item.icon}}</text>{{item.label}}
        </button>
      </view>
      <view wx:else class="optionGrid {{kind === 'sleep' ? 'twoOptions' : ''}}">
        <button wx:for="{{typeOptions}}" wx:key="value" class="{{type === item.value ? 'chosen' : ''}}" data-key="type" data-value="{{item.value}}" bindtap="pickValue">
          <text class="optionIcon">{{item.icon}}</text>{{item.label}}
        </button>
      </view>
    </view>

    <block wx:if="{{kind === 'sleep' && !recordId && sleepMode === 'quick'}}">
      <view wx:if="{{!ongoing}}" class="panel formPanel">
        <view class="featureLabel"><text>⚡</text><view>快捷睡眠记录<view class="inputCaption">一键补记刚刚结束的睡眠</view></view></view>
        <view class="optionGrid twoOptions quickSleep">
          <button wx:for="{{presets}}" wx:key="minutes" data-action="preset" data-minutes="{{item.minutes}}" disabled="{{busy}}" bindtap="sleepAction">{{item.label}}</button>
        </view>
      </view>
      <view class="panel formPanel row" bindtap="openCustomSleep">
        <view class="featureLabel"><text>🕰️</text><view>自定义睡眠<view class="inputCaption">选择已经完成的睡眠起止时间</view></view></view><text class="muted">›</text>
      </view>
      <view class="panel sleepActionPanel">
        <view class="sleepIcon">🌙</view>
        <view class="muted">{{ongoing ? '正在睡觉 · 开始于 ' + ongoingSince : '准备好让宝宝睡觉了吗？'}}</view>
        <button class="saveRecord" disabled="{{busy}}" data-action="{{ongoing ? 'end' : 'start'}}" bindtap="sleepAction">{{ongoing ? '结束睡眠' : '开始睡觉'}}</button>
      </view>
    </block>

    <block wx:if="{{kind !== 'sleep' || recordId || sleepMode === 'custom'}}">
      <view wx:if="{{kind === 'feeding' && isMilk}}" class="panel formPanel">
        <view class="formLabel">奶量</view>
        <input wx:if="{{recordId}}" type="number" data-key="amountMl" value="{{amountMl}}" bindinput="field" />
        <picker wx:else class="measurePicker" range="{{milkOptions}}" value="{{amountMl / 10}}" bindchange="chooseMilk">{{amountMl}} ml <text>⌄</text></picker>
        <view class="field" wx:if="{{recordId}}"><text class="fieldTitle">时长（分钟）</text><input type="number" data-key="durationMinutes" value="{{durationMinutes}}" bindinput="field" /></view>
      </view>
      <view class="panel formPanel" wx:if="{{kind === 'feeding' && hasFood}}">
        <view class="formLabel">选择辅食</view>
        <view class="optionGrid twoOptions dictionaryOptions">
          <button wx:for="{{foodChoices}}" wx:key="id" class="{{item.selected ? 'chosen' : ''}}" data-key="foodIds" data-value="{{item.id}}" bindtap="toggleItem">{{item.emoji}} {{item.name}}</button>
        </view>
        <view wx:if="{{!foodChoices.length}}" class="muted">请在「我的 → 辅食管理」添加</view>
      </view>
      <view wx:if="{{kind === 'feeding' && !recordId}}" class="panel formPanel">
        <view class="row">
          <view>补剂添加<view class="inputCaption">选填，可顺带记录本次补剂</view></view>
          <switch checked="{{includeSupplements}}" color="#55b861" bindchange="toggleSupplements" />
        </view>
        <view class="optionGrid twoOptions dictionaryOptions" wx:if="{{includeSupplements}}">
          <button wx:for="{{supplementChoices}}" wx:key="id" class="{{item.selected ? 'chosen' : ''}}" data-key="supplementIds" data-value="{{item.id}}" bindtap="toggleItem">{{item.emoji}} {{item.name}}</button>
          <view wx:if="{{!supplementChoices.length}}" class="muted">暂无启用的补剂</view>
        </view>
      </view>

      <view class="panel formPanel" wx:if="{{kind === 'temperature'}}">
        <view class="formLabel">宝宝体温</view>
        <view class="temperatureValue">{{temperature}}°C</view>
        <view class="row">
          <picker class="measurePicker" range="{{temperatureDegrees}}" value="{{degrees - 36}}" data-part="degree" bindchange="chooseTemperature">{{degrees}} <text>⌄</text></picker>
          <picker class="measurePicker" range="{{temperatureDecimals}}" value="{{decimal}}" disabled="{{temperature == 41}}" data-part="decimal" bindchange="chooseTemperature">{{decimal}} <text>⌄</text></picker>
        </view>
        <view class="inputCaption center">有效范围 36.0°C – 41.0°C</view>
      </view>
      <view class="panel formPanel" wx:if="{{kind === 'supplement'}}">
        <view class="formLabel">补剂名称</view>
        <view class="optionGrid twoOptions dictionaryOptions">
          <button wx:for="{{supplements}}" wx:key="id" class="{{name === item.name ? 'chosen' : ''}}" data-index="{{index}}" bindtap="chooseSupplement">{{item.emoji}} {{item.name}}</button>
        </view>
        <view class="muted" wx:if="{{!supplements.length}}">暂无启用的补剂</view>
      </view>
      <view class="panel formPanel" wx:if="{{kind === 'supplement'}}">
        <view class="formLabel">剂量</view>
        <view class="row"><input data-key="amount" value="{{amount}}" placeholder="剂量" bindinput="field" /><input data-key="unit" value="{{unit}}" placeholder="单位" bindinput="field" /></view>
      </view>
      <view class="panel formPanel" wx:if="{{kind === 'activity'}}">
        <view class="formLabel">{{eventType}}</view>
        <view wx:if="{{eventType === '运动'}}">
          <view class="optionGrid twoOptions dictionaryOptions"><button wx:for="{{exerciseChoices}}" wx:key="id" class="{{item.selected ? 'chosen' : ''}}" data-key="exerciseTypes" data-value="{{item.name}}" bindtap="toggleItem">{{item.emoji}} {{item.name}}</button></view>
          <view class="row field"><input type="digit" data-key="amount" value="{{amount}}" placeholder="数量" bindinput="field" /><text>{{unit}}</text></view>
        </view>
        <view class="field"><text class="fieldTitle">描述</text><input data-key="description" value="{{description}}" bindinput="field" /></view>
      </view>
      <view class="panel formPanel" wx:if="{{kind === 'growth'}}">
        <view wx:if="{{metric !== 'weight'}}"><text class="formLabel">身高（cm）</text><input type="digit" data-key="height" value="{{height}}" placeholder="输入本次测量的身高" bindinput="field" /></view>
        <view wx:if="{{metric !== 'height'}}"><text class="formLabel">体重（kg）</text><input type="digit" data-key="weight" value="{{weight}}" placeholder="输入本次测量的体重" bindinput="field" /></view>
        <view class="field" wx:if="{{recordId}}"><text class="formLabel">头围（cm）</text><input type="digit" data-key="headCircumference" value="{{headCircumference}}" bindinput="field" /></view>
      </view>
      <view class="panel formPanel" wx:if="{{kind === 'foodAllergy'}}">
        <view class="formLabel">辅食排敏</view><picker range="{{foodOptions}}" bindchange="chooseFood">{{foodName || '选择辅食'}}</picker>
      </view>
      <template wx:if="{{kind !== 'feeding' && kind !== 'diaper'}}" is="recordTime" data="{{label:kind === 'temperature' ? '测量时间' : kind === 'sleep' ? '开始时间' : '时间', date, time, today, quickTime:kind !== 'sleep', timePresets}}" />
      <view class="panel formPanel" wx:if="{{kind === 'sleep' && sleepMode === 'custom'}}">
        <view class="row"><text class="formLabel">结束时间</text></view>
        <view class="recordDateTime">
          <view><view class="inputCaption">日期</view><picker mode="date" value="{{endDate}}" end="{{today}}" data-key="endDate" bindchange="field">{{endDate}}</picker></view>
          <view><view class="inputCaption">时间</view><picker mode="time" value="{{endTime}}" data-key="endTime" bindchange="field">{{endTime}}</picker></view>
        </view>
      </view>
      <view class="panel formPanel" wx:if="{{kind === 'foodAllergy'}}">
        <view class="formLabel">症状观察</view>
        <view class="field line" wx:for="{{symptoms}}" wx:for-item="symptom" wx:key="key">
          <text>{{symptom.label}}</text><view class="inputCaption">{{symptom.window}}</view>
          <view class="segment"><button wx:for="{{observationStates}}" wx:key="value" class="{{observations[symptom.key] === item.value ? 'current' : ''}}" data-key="{{symptom.key}}" data-value="{{item.value}}" bindtap="observe">{{item.label}}</button></view>
        </view>
      </view>
      <view class="panel formPanel" wx:if="{{kind === 'foodAllergy'}}">
        <view class="formLabel">系统建议 · {{suggested}}</view>
        <view wx:if="{{urgent}}" class="error">观察到需要及时就医的症状</view>
        <view class="section">最终结论</view><view class="segment"><button wx:for="{{conclusionLabels}}" wx:key="value" class="{{finalConclusion === item.value ? 'current' : ''}}" data-key="finalConclusion" data-value="{{item.value}}" bindtap="pickValue">{{item.label}}</button></view>
      </view>
      <view class="panel formPanel" wx:if="{{kind !== 'temperature' || recordId}}">
        <view class="formLabel">备注</view><textarea data-key="remark" value="{{remark}}" placeholder="选填" bindinput="field" />
      </view>
      <button class="saveRecord" loading="{{busy && !saved}}" disabled="{{busy || (kind === 'growth' && !height && !weight && !headCircumference)}}" bindtap="submit">{{kind === 'temperature' ? '保存体温记录' : '保存记录'}}</button>
    </block>
  </block>
  <button wx:if="{{embedded}}" class="cancelRecord" disabled="{{busy}}" bindtap="cancel">取消</button>
</view>

<view wx:if="{{embedded && customOpen}}">
  <template is="customSleep" data="{{title, typeOptions, type, date, time, today, timePresets, endDate, endTime, remark, busy, embedded}}" />
</view>
<page-container
  wx:if="{{!embedded && kind === 'sleep' && !recordId}}"
  show="{{customOpen}}"
  duration="{{300}}"
  timing-function="ease-out"
  position="right"
  overlay="{{false}}"
  round="{{false}}"
  custom-style="width:100vw; height:100vh;"
  bind:afterleave="customSleepClosed"
>
  <template is="customSleep" data="{{title, typeOptions, type, date, time, today, timePresets, endDate, endTime, remark, busy, embedded}}" />
</page-container>

<template name="customSleep">
  <view class="screen detailScreen recordForm sleep {{embedded ? '' : 'customSleepPage'}}">
    <view class="detailHeader">
      <button class="backButton" aria-label="返回" disabled="{{busy}}" bindtap="closeCustomSleep"><view class="backChevron"></view></button>
      <view class="heading">{{title}}</view>
    </view>
    <view class="panel formPanel">
      <view class="formLabel">睡眠类型</view>
      <view class="optionGrid twoOptions">
        <button wx:for="{{typeOptions}}" wx:key="value" class="{{type === item.value ? 'chosen' : ''}}" data-key="type" data-value="{{item.value}}" bindtap="pickValue">
          <text class="optionIcon">{{item.icon}}</text>{{item.label}}
        </button>
      </view>
    </view>
    <template is="recordTime" data="{{label:'开始时间', date, time, today, quickTime:false, timePresets}}" />
    <view class="panel formPanel">
      <view class="row"><text class="formLabel">结束时间</text></view>
      <view class="recordDateTime">
        <view><view class="inputCaption">日期</view><picker mode="date" value="{{endDate}}" end="{{today}}" data-key="endDate" bindchange="field">{{endDate}}</picker></view>
        <view><view class="inputCaption">时间</view><picker mode="time" value="{{endTime}}" data-key="endTime" bindchange="field">{{endTime}}</picker></view>
      </view>
    </view>
    <view class="panel formPanel">
      <view class="formLabel">备注</view>
      <textarea data-key="remark" value="{{remark}}" placeholder="选填" bindinput="field" />
    </view>
    <button class="saveRecord" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">保存记录</button>
    <button wx:if="{{embedded}}" class="cancelRecord" disabled="{{busy}}" bindtap="cancel">取消</button>
  </view>
</template>
