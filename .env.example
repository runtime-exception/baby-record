# 微信小程序凭据（仅后端保存）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_ENV_VERSION=release
BABY_RECORD_SESSION_DAYS=30
BABY_RECORD_COOKIE_SECURE=true

# PostgreSQL 连接配置
DATABASE_HOST=your-postgres-host
DATABASE_PORT=3308
DATABASE_NAME=baby-db
DATABASE_USERNAME=baby_record
DATABASE_PASSWORD=change-this-database-password
